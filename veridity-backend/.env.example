# ========================
# SERVER
# ========================
PORT=4000
HOST=0.0.0.0
ENABLE_DEBUG=true

# ========================
# DATABASE
# ========================
MONGO_URI=mongodb://localhost:27017/ssi_platform

# ========================
# REDIS / WORKER QUEUE
# Used by the worker-backed protocol job flow.
# If Redis is unavailable, the code falls back to an in-process queue.
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ========================
# CONTROL PLANE AUTH / TENANCY
# ========================
CONTROL_PLANE_JWT_SECRET=dev-control-plane-secret
CONTROL_PLANE_AUTH_REQUIRED=false
CONTROL_PLANE_TENANT_REQUIRED=false

# ========================
# SSI CRYPTO / APP SECRETS
# ========================
JWT_SIGNING_KEY=dev-jwt-secret
SD_JWT_KEY=dev-sd-jwt-secret
BBS_PRIVATE_KEY=dev-bbs-private-key
KEY_SECRET=dev-key-secret

# ========================
# ETHEREUM
# Enable this when you are running the Ethereum runtime from docs/runtime-setup.md.
# Replace the placeholder private key and registry address with real values.
# ========================
ETH_NODE_URL=http://localhost:8545
ETH_PRIVATE_KEY=0xYOUR_ETHEREUM_PRIVATE_KEY
ETH_CHAIN_ID=31337
ETH_REGISTRY_ADDRESS=0xYOUR_UNIVERSAL_REGISTRY_ADDRESS
ETH_REGISTRY_DEPLOY_BLOCK=1

# Optional deploy-only overrides for non-local networks
DEPLOY_RPC_URL=
DEPLOY_PRIVATE_KEY=
DEPLOY_CHAIN_ID=

# ========================
# BITCOIN
# Enable this when you are running the Bitcoin runtime from docs/runtime-setup.md.
# ========================
BTC_NODE_URL=http://user:password@127.0.0.1:18443
BTC_WALLET_NAME=ssi_platform_wallet
BTC_NETWORK=regtest

# ========================
# OIDC / PROTOCOL SETTINGS
# Presently used as deployment-facing settings for protocol flows.
# ========================
OIDC_ISSUER_URL=http://localhost:4000
OIDC_CLIENT_ID=ssi-platform-client
OIDC_CLIENT_SECRET=ssi-platform-secret
OIDC_REDIRECT_URI=http://localhost:4000/callback
OIDC_VP_CLIENT_ID=ssi-platform-vp-client
OIDC_VP_REDIRECT_URI=http://localhost:4000/vp/callback

# ========================
# OPTIONAL FEATURE FLAGS
# These are not all enforced in code yet, but they document intended deployment toggles.
# ========================
ENABLE_DIDCOMM=false
ENABLE_ETHEREUM=false
ENABLE_BITCOIN=false

# Public protocol security hardening
PROTOCOL_ACCESS_TOKEN_TTL_SECONDS=600
PROTOCOL_NONCE_TTL_SECONDS=300
PROTOCOL_JWKS_ACTIVE_KID=phase4-rs256-active
PROTOCOL_JWKS_ROTATION_ENABLED=false
PROTOCOL_JWKS_NEXT_KID=phase4-rs256-next
# JSON array of extra public JWKs to expose during rotations
PROTOCOL_JWKS_ADDITIONAL_PUBLIC_KEYS_JSON=[]
PUBLIC_PROTOCOL_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_PROTOCOL_RATE_LIMIT_MAX=120
PUBLIC_PROTOCOL_TOKEN_RATE_LIMIT_MAX=30
