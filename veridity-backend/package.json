{
  "name": "ssi-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "main": "apps/api-server/src/server.ts",
  "scripts": {
    "dev": "pnpm --filter api-server dev",
    "build": "pnpm -r build",
    "build:workspaces": "pnpm -r --if-present build",
    "start": "pnpm --filter api-server start",
    "eth:node": "XDG_DATA_HOME=./cache/xdg-data XDG_CONFIG_HOME=./cache/xdg-config XDG_CACHE_HOME=./cache/xdg-cache ./node_modules/.bin/hardhat node",
    "eth:compile": "XDG_DATA_HOME=./cache/xdg-data XDG_CONFIG_HOME=./cache/xdg-config XDG_CACHE_HOME=./cache/xdg-cache ./node_modules/.bin/hardhat compile",
    "eth:deploy": "XDG_DATA_HOME=./cache/xdg-data XDG_CONFIG_HOME=./cache/xdg-config XDG_CACHE_HOME=./cache/xdg-cache ./node_modules/.bin/hardhat run scripts/ethereum/deploy-universal-registry.ts --network localhost",
    "eth:deploy:external": "XDG_DATA_HOME=./cache/xdg-data XDG_CONFIG_HOME=./cache/xdg-config XDG_CACHE_HOME=./cache/xdg-cache ./node_modules/.bin/hardhat run scripts/ethereum/deploy-universal-registry.ts --network external",
    "eth:print-env": "pnpm exec tsx scripts/ethereum/print-env.ts",
    "test": "pnpm -r build && pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@sd-jwt/core": "^0.19.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.6",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "class-validator-jsonschema": "^5.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "fastify": "^5.8.2",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "jsonld": "^9.0.0",
    "jsonld-signatures": "^11.6.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "tweetnacl": "^1.0.3",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/axios": "^0.9.36",
    "@types/bs58": "^4.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.4.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "hardhat": "^2.28.6",
    "jest": "^30.3.0",
    "solc": "0.8.26",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
